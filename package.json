{
  "name": "django-starter-template-ui",
  "version": "1.0.0",
  "description": "Tailwind CSS and DaisyUI build setup for Django",
  "scripts": {
    "build:css": "tailwindcss -i ./static/css/input.css -o ./static/css/dist/output.css --minify",
    "watch:css": "tailwindcss -i ./static/css/input.css -o ./static/css/dist/output.css --watch"
  },
  "devDependencies": {
    "daisyui": "^4.12.23",
    "tailwindcss": "^3.4.17"
  }
}
