# Django Environment Configuration
# Copy this file to .env and adjust variables as needed

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=django-insecure-starter-template-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Database
# Default development uses SQLite if DATABASE_URL is not set or set to sqlite
# For PostgreSQL in dev/production: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Security & CORS
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Email (console backend for development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
